# ==============================================================================
# RAVEN BOT X - Environment Variables Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# DO NOT commit the .env file with real secrets to version control!
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_SampleToken

# Primary Bot Administrators (comma-separated Telegram User IDs)
ADMIN_IDS=123456789,123456789

# Default Bot UI Language (options: ar, en, ur, ru, tr, fa, hi)
DEFAULT_LANGUAGE=ar

# Target Traffic Service Base URL
IVASMS_BASE_URL=https://www.ivasms.com

# Target Traffic Service Portal Endpoint
IVASMS_RECEIVED_PATH=/portal/sms/received

# Optional: Dedicated Broadcast Channel/Group ID (e.g. -1001234567890)
LIVE_STREAM_CHAT_ID=

# Storage Paths
DATABASE_PATH=bot1.db
COOKIES_FILE=mafia_ck_4235.json
ACTIVE_HEADERS_FILE=active_headers.json
